# Copy this file to .env and fill in your own keys.
# cp .env.example .env

# Groq (vision diagnosis + chat) — required.
# GROQ_API_KEY is required; GROQ_API_KEY_2 / _3 / ... are optional extra keys.
# If a key hits its rate limit, the backend automatically falls back to the
# next one instead of failing the request.
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# Azure AI Speech (text-to-speech for "listen to results") — required for /speak
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastasia

# ElevenLabs Scribe (speech-to-text for "ask by voice") — required for /transcribe
ELEVENLABS_SCRIBE_API_KEY=...
