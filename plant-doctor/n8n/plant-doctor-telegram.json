      "typeVersion": 1.2,
      "position": [
        1300,
        120
      ],
      "credentials": {
        "telegramApi": {
          "id": "PLANT_DOCTOR_TG",
          "name": "Plant Doctor Bot"
        }
      }
    },
    {
      "parameters": {
