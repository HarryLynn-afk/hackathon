        "additionalFields": {}
      },
      "id": "ack-button",
      "name": "Ack Button",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        420,
        320
      ],
      "credentials": {
        "telegramApi": {
          "id": "PLANT_DOCTOR_TG",
          "name": "Plant Doctor Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Normalize').first().json.chatId }}",
        "text": "={{ $('Normalize').first().json.cropName + ' ကို ရွေးထားပါတယ်။\\n\\n📷 ရောဂါဖြစ်နေတဲ့ အရွက်ကို နီးနီးကပ်ကပ်၊ အလင်းရောင်ကောင်းကောင်းနဲ့ ရိုက်ပြီး ဓာတ်ပုံပို့ပေးပါနော်။' }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "ask-for-photo",
      "name": "Ask For Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        640,
        320
      ],
      "credentials": {
        "telegramApi": {
          "id": "PLANT_DOCTOR_TG",
          "name": "Plant Doctor Bot"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "🌿 အပင်ဆရာဝန် မှ ကြိုဆိုပါတယ်။\n\nဘယ်သီးနှံလဲ ရွေးပေးပါ 👇",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "🌾 စပါး",
                    "additionalFields": {
